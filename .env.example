# Copy this file to .env and fill in your own values. .env is git-ignored; never commit real credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=unispace

# Flask. Debug exposes an interactive debugger: leave it off anywhere other people can reach.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Browser origins allowed to call the API (the frontend dev server), comma separated.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Signs login tokens. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
